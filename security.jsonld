    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/security.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is Quantocos ISO 27001 certified?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not yet. The company was incorporated in 2026 and does not hold an ISO 27001 certificate or a SOC 2 report. The control set is documented and available for review; we will publish the certificate when it exists rather than imply it today."
          }
        },
        {
          "@type": "Question",
          "name": "Where is client data processed?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Primary delivery is from India. Data residency is assessed per engagement, and any deviation is written into the DPA. We do not claim a local data centre in every buyer market."
          }
        },
        {
          "@type": "Question",
          "name": "Do you train AI models on client data?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Client material is not used to train shared or foundation models. Access is controlled per client, and the terms are written into the DPA."
          }
        },
        {
          "@type": "Question",
          "name": "Can we review your security pack before signing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Ask for the security pack through the contact form and we will send the DPA, the current subprocessor list and the AI assurance note."
          }
        },
        {
          "@type": "Question",
          "name": "Who signs off on an AI-assisted deliverable?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A named human specialist. Agents draft and repeat; a specialist reviews and approves before anything is released, and the approval is recorded."
          }
        }
      ]
    }
  ]
