    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/contracts.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can we sign our own paper instead of yours?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ask. Where your procurement requires your master agreement, we will review it and say plainly what we can and cannot accept. A small company should not promise to absorb liability it cannot insure, and we would rather decline a clause at the start than dispute it later."
          }
        },
        {
          "@type": "Question",
          "name": "Do you hold ISO 27001 or SOC 2?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not yet. The company was incorporated in 2026 and holds neither certificate. The control set is documented, the security page states each control and its status, and we will publish the certificates when they exist rather than imply them today."
          }
        },
        {
          "@type": "Question",
          "name": "Is there a termination fee?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. You stop at the month boundary with one month of notice. There is no exit fee, no unused-credit clawback and no minimum term beyond the month you are in."
          }
        },
        {
          "@type": "Question",
          "name": "Who signs for Quantocos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The engagement is with Quantocos Global Systems LLP, the parent entity. The name of the signatory and their authority are stated in the engagement letter."
          }
        },
        {
          "@type": "Question",
          "name": "Can we review the pack before we are a customer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The DPA, the security questionnaire and the AI assurance note are available before any engagement exists. Ask through the contact form and say which documents your reviewer needs."
          }
        }
      ]
    }
  ]
