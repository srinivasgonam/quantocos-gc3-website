    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/solutions/remau.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is REMAU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "REMAU is Quantocos's real-estate marketing and automation pod. It combines project launch marketing, NRI-targeted digital campaigns, 3D and XR visualisation, CRM automation and RERA-aware communication in one team at $8,000/month for 240 hours."
          }
        },
        {
          "@type": "Question",
          "name": "How much does REMAU cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "REMAU costs $8,000/month for 240 included hours, with capacity for 280 hours during two surge weeks twice a year. The minimum engagement is three months because of the depth of setup on a launch."
          }
        },
        {
          "@type": "Question",
          "name": "What does 'shared pod' mean?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "REMAU runs on the shared pod model: a dedicated pod manager for your account and access to a shared specialist pool. That is what allows peak weeks to draw 280 hours from a 240-hour subscription without renegotiating the contract."
          }
        },
        {
          "@type": "Question",
          "name": "Which diaspora markets do you cover?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "NRI-targeted campaigns run across the United States, United Kingdom, United Arab Emirates and Australia and New Zealand, in English."
          }
        },
        {
          "@type": "Question",
          "name": "Is the marketing RERA-aware?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. RERA-aware marketing is explicitly in scope, and claims in launch communication are written to stay defensible against the regulatory framework the project sits under."
          }
        },
        {
          "@type": "Question",
          "name": "Can you produce the 3D walkthroughs as well as the campaign?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. 3D walkthroughs and XR visualisation are inside REMAU, with XR walkthrough production coordination handled by the same pod manager who runs the campaign."
          }
        }
      ]
    }
  ]
