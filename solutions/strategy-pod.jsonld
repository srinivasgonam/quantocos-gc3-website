    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/solutions/strategy-pod.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does the Strategy Pod cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Strategy Pod costs $9,000/month and includes 360 credits. It contains the strategy, creative and digital marketing catalogues, so the same pod that writes the positioning also produces the campaign that follows it."
          }
        },
        {
          "@type": "Question",
          "name": "Is the Strategy Pod the same as the Growth Pod?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The tier is called the Strategy Pod and is also referred to as the Growth Pod; both names describe the same $9,000/month pod containing all three catalogues."
          }
        },
        {
          "@type": "Question",
          "name": "How does it compare with a fractional CMO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A fractional CMO retainer typically runs $10,000–$12,000/month, with most engagements between $8,000 and $15,000, and buys senior thinking without a production team. The Strategy Pod costs $9,000 and includes strategy, creative and digital execution."
          }
        },
        {
          "@type": "Question",
          "name": "What does the strategy work actually produce?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Positioning and messaging architecture, market and competitor research, pricing and packaging, sales playbooks, content strategy, a marketing stack audit, IT and AI roadmaps, and an operating model where one is needed — delivered as documents the same pod then executes against."
          }
        },
        {
          "@type": "Question",
          "name": "Do we need the creative and digital work too?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The catalogues are additive rather than bundled: a client can run strategy alone and spend credits only there, or move the same credits into execution as the priorities change."
          }
        },
        {
          "@type": "Question",
          "name": "What is the minimum commitment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The three subscription pods are month to month. Custom pods and the real-estate pod REMAU carry a three-month minimum because of the depth of the initial setup."
          }
        }
      ]
    }
  ]
