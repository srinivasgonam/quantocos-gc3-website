    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/solutions/digital-pod.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does the Digital Pod cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Digital Pod costs $6,000/month and includes 240 credits, which is twice the Creative Pod's pool. It contains the Creative and digital marketing catalogues, so credits can be spent on either production or performance work."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between the Creative Pod and the Digital Pod?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Creative Pod is production only: content, design, copy and video. The Digital Pod adds digital marketing — SEO, answer-engine optimisation, paid media, landing pages, analytics and lifecycle email — and doubles the team and the credit pool."
          }
        },
        {
          "@type": "Question",
          "name": "Does the Digital Pod replace a marketing agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For most mid-market businesses, yes: it replaces the creative retainer and the media retainer with one pod, one manager and one dashboard."
          }
        },
        {
          "@type": "Question",
          "name": "What is answer-engine optimisation?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AEO and GEO work is the practice of making a business legible to answer engines and generative engines — ChatGPT, Perplexity, Google AI Overviews — so it is quoted or cited when someone asks a question in that market. The Digital Pod includes it alongside conventional SEO."
          }
        },
        {
          "@type": "Question",
          "name": "Can we move up or down between pods?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The pods are additive: the Digital Pod includes Creative, and the Strategy Pod includes both. Most teams start with one pod, run a quarter, then move up or add a custom pod alongside it."
          }
        },
        {
          "@type": "Question",
          "name": "Which currencies and time zones do you work in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The pod works across US, UK, UAE, ANZ and EU time zones. Billing is in US dollars."
          }
        }
      ]
    }
  ]
