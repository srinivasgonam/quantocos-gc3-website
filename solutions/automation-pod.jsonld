    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/solutions/automation-pod.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the Automation Pod?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Automation Pod is a scoped Quantocos engagement that finds and removes manual work. It starts with a per-department audit, then builds workflows, chatbots, voice agents and role-specific AI agents, scoped on the same terms as every other pod."
          }
        },
        {
          "@type": "Question",
          "name": "What does the Automation Pod cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The audit is scoped first, because automation depth varies too much to publish an honest fixed price. Once scoped, the work is quoted on the same terms — a credit per unit of work — exactly like the subscription pods."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between simple, standard and complex workflows?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Simple workflows move data between two systems. Standard workflows add conditional logic and more than two systems. Complex workflows involve human approval steps, unstructured documents or multiple agents coordinating — and those are where most of the value sits."
          }
        },
        {
          "@type": "Question",
          "name": "Will an agent make decisions without us knowing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Deployments keep a human approval step on anything consequential, and agent activity is monitored and evaluated. The design assumption is that an agent drafts and repeats while a named person approves."
          }
        },
        {
          "@type": "Question",
          "name": "Do we need to replace the tools we already use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The pod integrates with the systems already in place. Where a client wants the single-licence model instead, the platform products replace that surface over time."
          }
        },
        {
          "@type": "Question",
          "name": "How do you decide what to automate first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "By volume multiplied by monotony: the processes that consume the most hours for the least judgement. The audit ranks them and the pod builds in that order."
          }
        }
      ]
    }
  ]
}
