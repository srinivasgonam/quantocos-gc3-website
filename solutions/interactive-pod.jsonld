    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/solutions/interactive-pod.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What kind of work does the Interactive Pod do?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Real-estate and product visualisation, browser-based 3D configurators, scrollytelling microsites, VR showrooms, XR training modules and game-engine prototypes. Work is web-first with device and performance budgets agreed before the build."
          }
        },
        {
          "@type": "Question",
          "name": "Which tools and engines do you build with?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The pipeline spans Spline, Figma, Framer, Webflow, Verge3D, 8th Wall, Godot, GDevelop and Blender, chosen per project rather than forced into one stack."
          }
        },
        {
          "@type": "Question",
          "name": "Can a 3D walkthrough run in a normal browser?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Web-first delivery means the experience runs from a link without a headset or an app install, with a device and performance budget agreed up front so it stays usable on mid-range phones."
          }
        },
        {
          "@type": "Question",
          "name": "How does this relate to REMAU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "REMAU is the real-estate specific pod: it includes interactive and XR work as part of a launch campaign. The Interactive Pod is the build capability on its own, for any sector."
          }
        },
        {
          "@type": "Question",
          "name": "How long does a configurator or walkthrough take?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is scoped from the asset inventory and the interaction list, then booked in sprints with a credit estimate per item. Nothing is built before you have seen the estimate."
          }
        },
        {
          "@type": "Question",
          "name": "Do you produce the underlying 3D assets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, model production and optimisation are part of the pod, as is retopology and asset compression for web delivery."
          }
        }
      ]
    }
  ]
