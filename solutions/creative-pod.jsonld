    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/solutions/creative-pod.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How much does the Creative Pod cost?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Creative Pod costs $3,000/month and includes 120 credits. One credit equals the unit the portal bills in. Onboarding, brief clarification, asset handover and the monthly pod review are never drawn from those credits."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in the $3,000/month?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One pod manager, two human specialists, two AI agents, 120 credits of work per month, and every software licence the pod needs — design and creative applications, AI generation, stock imagery and fonts. There are no add-on fees."
          }
        },
        {
          "@type": "Question",
          "name": "Who actually does the work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "AI agents draft and repeat the repeatable work; human specialists review, correct and finish it. Nothing is delivered that a named human has not signed off, and the pod manager is accountable for the outcome."
          }
        },
        {
          "@type": "Question",
          "name": "How is this different from a freelancer or an agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A pod is a function with a calendar and a manager, not a series of tickets. It is priced as a subscription with a visible credit pool, so the second month is cheaper to run than the first and scope is settled before work begins."
          }
        },
        {
          "@type": "Question",
          "name": "What does the Creative Pod not include?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Paid media management, SEO and strategy. Those sit in the Growth and Strategy catalogues, which the Digital Pod and Strategy Pod include. The Creative Pod is the production layer only."
          }
        },
        {
          "@type": "Question",
          "name": "Can we use the pod under our own brand?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Agencies and consultancies run pods white-label for their own clients. The engagement is with Quantocos, the client relationship stays with you."
          }
        }
      ]
    }
  ]
