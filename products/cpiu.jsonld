    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/cpiu.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What does CPIU stand for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Central Pod Intelligence Unit. It is the internal oversight layer above the client portal, monitoring pod health and workload, assigning clients to pods and reporting regional performance."
          }
        },
        {
          "@type": "Question",
          "name": "Can clients see CPIU?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. CPIU is internal. Clients see the GC³ Portal; CPIU is how the group sees itself, including the parts a client would rather not have to manage."
          }
        },
        {
          "@type": "Question",
          "name": "What problem does it solve?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It makes capacity and quality observable internally before they become visible to a client — the difference between planning for a busy quarter and discovering it."
          }
        }
      ]
    }
