    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/friday.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Friday?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Friday is a local device agent, in development. It runs on an employee's own machine, works across their local files and applications, completes multi-step tasks, and shows each result for approval before anything is acted on."
          }
        },
        {
          "@type": "Question",
          "name": "Why run an agent locally instead of in the cloud?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because the material worth automating is usually the material that must not be uploaded. Running on the device means contracts, records and unpublished figures do not have to leave the machine to be worked on."
          }
        },
        {
          "@type": "Question",
          "name": "Does Friday send data anywhere?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is designed so that it does not have to. Where a task needs a capability the device does not have, the request is explicit rather than automatic."
          }
        }
      ]
    }
  ]
