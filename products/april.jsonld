    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/april.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is April?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "April is Quantocos's company-wide AI agent, in development. It holds the context of the company, its clients, employees and vendors, turns a client brief into design tokens and working documentation, and completes roughly half the work on an engagement."
          }
        },
        {
          "@type": "Question",
          "name": "Does April work unsupervised?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. April takes the brief and drafts; a human specialist reviews, corrects and signs off. Nothing is delivered that a named person has not approved, and the activity is recorded so a reviewer can audit any branch."
          }
        },
        {
          "@type": "Question",
          "name": "Is April conscious, or an AGI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. April is a well-instrumented agent with access to good context, built so the system behaves as though it were widely informed. It is not conscious and it is not omniscient, and it is described that way deliberately."
          }
        }
      ]
    }
  ]
