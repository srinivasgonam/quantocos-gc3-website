    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/portal.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the GC³ Portal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The GC³ Portal is the client-side view of the capability centre — built and running. It covers onboarding, request intake with credit estimates, billing and subscriptions, work hours, credits, team communication and the monthly pod review."
          }
        },
        {
          "@type": "Question",
          "name": "Do clients see the credit cost before work starts?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Every request is estimated in credits before a pod picks it up, and that estimate is visible to the client. The closing balance is visible too, so there is no reconciliation meeting."
          }
        },
        {
          "@type": "Question",
          "name": "Can our own team use the portal?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Client teams get their own users with their own permissions, so requests come from the people closest to the work rather than through one coordinator."
          }
        }
      ]
    }
  ]
