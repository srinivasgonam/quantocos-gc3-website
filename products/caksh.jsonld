    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/caksh.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Caksh?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Caksh is an ontological research tool, in development. It applies node-based visual compositing to data instead of footage, so a researcher can see how entities and signals relate rather than reading them out of a table."
          }
        },
        {
          "@type": "Question",
          "name": "Who is it for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "OSINT, cyber-security and SOC teams first, where the technique came from; national intelligence and medical research are the adjacent cases where the same relationship problems appear."
          }
        },
        {
          "@type": "Question",
          "name": "What does 'ontological' mean here?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "That the tool works on what things are and how they relate, not just on their values — categorising an entity and observing how it behaves across sources, rather than matching strings."
          }
        }
      ]
    }
  ]
