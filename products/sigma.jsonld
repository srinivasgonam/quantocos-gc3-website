    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/sigma.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Sigma?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sigma is a memory management tool, in development. It captures fragments worth keeping from any chat surface, compiles them into memory, turns them into skills and modules, and serves the result to agents and to Qore."
          }
        },
        {
          "@type": "Question",
          "name": "How is this different from a chat history?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A chat history records what was said. Sigma keeps what was learned, in a form another person or agent can reuse, with the fragments composited into modules rather than left as transcripts."
          }
        },
        {
          "@type": "Question",
          "name": "Where does the memory live?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In the tenant it belongs to, served through Apara, with role-based access control. Memory that cannot be permissioned is not much use to an enterprise."
          }
        }
      ]
    }
  ]
