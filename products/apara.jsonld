    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/apara.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Apara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Apara is Quantocos's cloud platform, in development. It supplies storage, LLM provision and routing, API and MCP hosting, CDN delivery, role-based access control and tenant management to every other product in the group."
          }
        },
        {
          "@type": "Question",
          "name": "Where does client data live?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Client material is held in the tenant it belongs to and is not used to train shared models. Access is controlled at the tenant level with role-based permissions, and clients are told which regions their data is served from."
          }
        },
        {
          "@type": "Question",
          "name": "Do we have to move to Apara to work with Quantocos?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The pods integrate with the systems a client already runs. Apara is the substrate for the group's own products; moving onto it is a direction, not a precondition."
          }
        }
      ]
    }
  ]
