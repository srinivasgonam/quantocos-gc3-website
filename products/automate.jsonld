    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/automate.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Automate?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Automate is the automation surface in Prism, in development. It is a node-based canvas for building agentic workflows that can drive the other six surfaces directly, instead of depending on integration glue between unrelated tools."
          }
        },
        {
          "@type": "Question",
          "name": "How is it different from n8n or Zapier?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In function it is comparable to n8n, Langflow, CrewAI and AutoGen. The difference is scope: the tools it automates are surfaces of the same product, so a workflow can reach into generation, code, documents and marketing without an external connector."
          }
        },
        {
          "@type": "Question",
          "name": "Can it integrate with tools outside Prism?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Third-party integrations and API work are inside the surface — because no client's estate is going to be entirely one vendor's."
          }
        }
      ]
    }
  ]
