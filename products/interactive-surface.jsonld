    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/interactive-surface.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Interactive?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Interactive is the immersive production surface in Prism, in development. It covers AR and VR development, web-based 3D configurators, motion-led sites and game-engine prototyping, using a pipeline that spans Spline, Figma, Framer, Webflow, Verge3D, 8th Wall, Godot, GDevelop and Blender."
          }
        },
        {
          "@type": "Question",
          "name": "Does Interactive require headsets?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. Delivery is web-first, so an experience runs from a link on a normal browser. Headset-ready VR is available where the use case justifies it."
          }
        },
        {
          "@type": "Question",
          "name": "How does this relate to the Interactive Pod?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The pod is what a client buys; Interactive is the surface the pod builds in. The same specialists work in both."
          }
        }
      ]
    }
