      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/martech.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Martech?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Martech is the digital marketing surface in Prism, in development. It covers SEO and answer-engine optimisation, paid advertising, social scheduling and sentiment analysis, CRM and email, broadcast messaging, and OSINT audience research — on one set of numbers."
          }
        },
        {
          "@type": "Question",
          "name": "What does sentiment analysis add?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It turns social from a publishing channel into a listening one, so a campaign's effect on how people talk about the brand is visible rather than anecdotal."
          }
        },
        {
          "@type": "Question",
          "name": "Why is OSINT in a marketing tool?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because audience research is research. The same techniques used for open-source intelligence answer commercial questions about who a market is and what it actually cares about."
          }
        }
      ]
    }
