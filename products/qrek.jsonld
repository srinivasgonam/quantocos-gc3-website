    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/qrek.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What are QREK and QRT?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "QREK is the Quantocos Runtime Environment Kernel, a Linux-based operating system for capability centres, in development. QRT is the runtime on top of it that provides the skills, MCPs and libraries agents are built against."
          }
        },
        {
          "@type": "Question",
          "name": "Why build an operating system?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because the alternative is the thing enterprises are stuck on: forty tools, forty licences, forty integrations and a specialist per capability. One substrate means an agent built for one surface can work on another."
          }
        },
        {
          "@type": "Question",
          "name": "Is QREK available?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. QREK and QRT are in development and are not generally available. Client runs on the parts of the stack that are proven."
          }
        }
      ]
    }
  ]
