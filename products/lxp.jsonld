    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/lxp.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is the LXP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The LXP is Quantocos's learning experience platform, in development. It delivers the same material through audio, visual, interactive and kinetic pathways so that different learners can reach the same competence in the format that works for them."
          }
        },
        {
          "@type": "Question",
          "name": "What is the E2E framework?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "E2E stands for Educating Through Experience. It is built on the observation that people learn differently and that most corporate learning addresses only one of the VARK styles — visual, auditory, reading/writing and kinetic."
          }
        },
        {
          "@type": "Question",
          "name": "How does the LXP connect to the rest of the group?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Learning, assessment and recognition are one loop: the LXP delivers, ASTX proves whether it landed, and HPCF records the credits and shows them on a guild board."
          }
        }
      ]
    }
  ]
