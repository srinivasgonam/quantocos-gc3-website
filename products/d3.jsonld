    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/d3.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is D3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "D3, Due Diligence David, is a document management tool for legal and financial work, in development. Every document the group issues gets a unique identifier that a third party can check in a public verification space."
          }
        },
        {
          "@type": "Question",
          "name": "How does verification work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A person holding the document — a candidate, a vendor, a bank — enters its identifier in the public space and confirms that the document was genuinely issued, rather than trusting a letterhead image."
          }
        },
        {
          "@type": "Question",
          "name": "Does D3 support digital signing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Digital signing is part of the product, so a document can be issued, signed and later verified without the original parties being involved."
          }
        }
      ]
    }
