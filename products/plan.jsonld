    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/plan.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Plan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Plan is the planning surface in Prism, in development. It holds the wiki, mind maps, presentations, documents, spreadsheets and structured data that a strategy engagement produces, in one workspace rather than across four file types."
          }
        },
        {
          "@type": "Question",
          "name": "Who is it for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Strategy and consulting work first — the Strategy Pod writes in it — and any team whose output is documents and models rather than campaigns."
          }
        },
        {
          "@type": "Question",
          "name": "Can we export from Plan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Everything is exportable and presentable, which matters for client work: a workspace that cannot produce a deck a client will accept is not a workspace."
          }
        }
      ]
    }
