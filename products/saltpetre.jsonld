    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/saltpetre.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Saltpetre?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Saltpetre is the research and data surface in Prism, in development. It ingests URLs, articles, images and video, filters the noise out of them, and turns what is left into datasets, MCPs, plugins and skills."
          }
        },
        {
          "@type": "Question",
          "name": "What are the outputs used for?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Fine-tuning and training custom models, building agent skills, and feeding the group's own tools — including Caksh, which applies the same compositing idea to research data."
          }
        },
        {
          "@type": "Question",
          "name": "Does it scrape the web?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It ingests content a client is entitled to use, including their own archives and licensed sources. Data provenance is part of the surface, not an afterthought."
          }
        }
      ]
    }
