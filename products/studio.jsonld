    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/studio.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is Studio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Studio is the synthetic media surface in Prism, in development. It puts AI generation of image, video, 3D, music and backgrounds alongside the photo, video, audio and 3D editors needed to finish the work, in one interface."
          }
        },
        {
          "@type": "Question",
          "name": "Why does it matter that generation and editing are together?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because the handoff is where the time goes. Generation that cannot be finished in place produces raw material and a file-management problem, not an outcome."
          }
        },
        {
          "@type": "Question",
          "name": "How is work stored?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Locally first, with selected assets synced to Apara — closer to a cloud drive that keeps what matters than to a full mirror of every draft."
          }
        }
      ]
    }
