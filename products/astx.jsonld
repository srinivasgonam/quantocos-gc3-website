    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/astx.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is ASTX?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "ASTX, Advanced Systems Thinking, is an assessment platform, in development. It combines proctored examinations with interactive scenarios and simulation-based assessment, and awards credits for skills that have been verified."
          }
        },
        {
          "@type": "Question",
          "name": "Why assess systems thinking?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Because the work that remains for people once agents handle the routine is judgement about systems — what to build, what to stop, what a change will break. That is assessable, and almost nobody assesses it."
          }
        },
        {
          "@type": "Question",
          "name": "How does ASTX connect to learning?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The LXP delivers learning through the E2E framework; ASTX proves whether it landed; HPCF records the credits and shows them on a guild board. The three are one loop."
          }
        }
      ]
    }
