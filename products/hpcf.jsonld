    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/hpcf.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is HPCF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "HPCF is the Human Performance and Culture Framework, in development. It is the HR portal — leave, payroll, attendance — with a gamification layer that rewards time saved rather than hours logged, through credits and guild leaderboards."
          }
        },
        {
          "@type": "Question",
          "name": "What are credits in HPCF?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Credits are earned when someone's work saves the group time. They accumulate on a guild leaderboard and can be monetised, which is how the incentive points at leverage instead of attendance."
          }
        },
        {
          "@type": "Question",
          "name": "How does the guild structure fit in?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Every employee belongs to one guild, and guild leaders are accountable for developing the people in it. HPCF makes that visible instead of aspirational."
          }
        }
      ]
    }
