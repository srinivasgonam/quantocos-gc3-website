    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/products/cobridge.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is CoBridge?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CoBridge is the communication layer between agents. A main agent creates subagents and distributes work, and every agent records what it produced on a channel the others can read, so the whole tree can be audited."
          }
        },
        {
          "@type": "Question",
          "name": "What are nanoagents?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nanoagents sit at the bottom of the tree and do one deterministic job each — too small to be useful alone, but reliable in aggregate and cheap to verify."
          }
        },
        {
          "@type": "Question",
          "name": "What is the point of recording agent messages?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Auditability. The common failure of multi-agent systems is that work vanishes into a hierarchy nobody can inspect. CoBridge keeps a record so a specialist can trace exactly which agent produced a given output."
          }
        }
      ]
    }
  ]
