        {
          "@type": "Question",
          "name": "Can you handle peak volumes?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The master asset is built once and resized for every placement. Peak-month credits are agreed before the season, not requested during it."
          }
        },
        {
          "@type": "Question",
          "name": "Do you produce marketplace-specific variants?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Feed, story, paid placement and storefront crops are produced from the same approved master."
