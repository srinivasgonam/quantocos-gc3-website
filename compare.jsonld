    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/compare.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is a pod cheaper than an agency?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "For recurring work, usually yes. A Creative Pod is $3,000 a month for 120 credits, and a Digital Pod is $6,000 for 240 credits. An agency retainer for the same disciplines typically starts at $5,000–$20,000 a month, before media or production costs. A pod is not cheaper for a one-off project that fits inside a single quote."
          }
        },
        {
          "@type": "Question",
          "name": "Is a pod the same as an offshore GCC?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. A global capability centre is usually a captive team the client employs or contracts directly, with the client carrying recruitment, management and utilisation risk. A GCA3 pod is a subscription: the team, the tools, the manager, the review gate and the credit pool are all included in one monthly figure."
          }
        },
        {
          "@type": "Question",
          "name": "Can we start with one small piece of work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The first month can be a single catalogue brief inside the pod's credit allowance. There is no setup fee, and the pod is month to month after the minimum term stated on the pod page."
          }
        },
        {
          "@type": "Question",
          "name": "What happens to unused credits?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Credits are a pool for the month and do not roll over. The allowance is agreed before the month starts, and the portal shows what has been spent and what is left."
          }
        },
        {
          "@type": "Question",
          "name": "When is a pod the wrong choice?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "When you need a one-off regulated opinion, a single specialist for a few hours, or a 50-person transformation you intend to employ. In those cases a freelancer, a professional firm or a captive team is the honest answer."
          }
        }
      ]
    }
  ]
}
