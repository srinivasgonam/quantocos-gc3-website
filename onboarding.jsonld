    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/onboarding.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What happens on day one?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "A kick-off call with your named manager. The first-quarter calendar is agreed in that call, access is arranged the same week, and the first brief is opened with a credit estimate before any work starts. There is no discovery phase to sit through first."
          }
        },
        {
          "@type": "Question",
          "name": "How quickly is the first output delivered?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Five working days after integration. Integration means access to your tools and the brand material the pod works from. The calendar is agreed before that clock starts, so the first output is not a surprise."
          }
        },
        {
          "@type": "Question",
          "name": "Who do I deal with during onboarding?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "One named manager, the same person for the life of the engagement. They own the calendar, the brief and the review gate. There is no account team between you and the pod, and no hand-off to a delivery layer once the contract is signed."
          }
        },
        {
          "@type": "Question",
          "name": "What do you need from us to start?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Four things: the brand assets, access to the tools you already work in, the name of the person who approves output, and a first brief. The brief can be rough. A list of what is slipping is enough to open one."
          }
        },
        {
          "@type": "Question",
          "name": "What if the first month does not work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "You stop at the month boundary. There is no lock-in, no notice period beyond the month, and no termination fee. The credit ledger for the month is yours, which also means you can see exactly what the money bought."
          }
        }
      ]
    }
  ]
}
