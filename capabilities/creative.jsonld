    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/capabilities/creative.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is in the Creative catalogue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eight service lines: social media content and calendars, brand assets and layout, copywriting and editorial, short-form video and motion, presentation and sales decks, photography direction and retouching, campaign key visuals, and print and packaging artwork."
          }
        },
        {
          "@type": "Question",
          "name": "Which pods include the Creative catalogue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "All four subscription pods include it — the Creative Pod, the Digital Pod, the Strategy Pod and REMAU — because every pod needs production underneath it."
          }
        },
        {
          "@type": "Question",
          "name": "Who sets the quality standard for creative work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Creative guild: a body of designers, writers and motion specialists that runs critique, holds the standards and is accountable for developing the craft of the people in it, separately from the pod that ships the work."
          }
        },
        {
          "@type": "Question",
          "name": "Can creative work be bought without a full pod?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not at present. The Creative Pod at $3,000/month is the smallest unit, which includes 120 credits, a pod manager, two specialists and two AI agents."
          }
        }
      ]
    }
  ]
