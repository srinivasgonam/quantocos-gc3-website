    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/capabilities/growth.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is in the digital marketing catalogue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ten service lines: SEO, answer-engine and generative-engine visibility (AEO and GEO), paid search and social, programmatic and retail media, landing pages and conversion work, analytics and dashboards, lifecycle and email marketing, lead generation, community management, and SEO and content audits."
          }
        },
        {
          "@type": "Question",
          "name": "What is the difference between SEO and AEO?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SEO optimises for a ranked list of links. AEO and GEO optimise to be the answer a generative engine gives — quoted, cited and attributed — which depends on structured data, unambiguous claims and machine-readable facts rather than on keyword density."
          }
        },
        {
          "@type": "Question",
          "name": "Which pods include digital marketing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Digital Pod at $6,000/month and the Strategy Pod at $9,000/month. The Creative Pod and REMAU do not — although REMAU includes real-estate digital marketing as part of its launch scope."
          }
        },
        {
          "@type": "Question",
          "name": "Do you do the technical SEO work as well?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Technical SEO, tracking implementation and analytics are inside the catalogue, because a campaign cannot be measured with broken instrumentation."
          }
        }
      ]
    }
  ]
