    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/capabilities/strategy.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is in the strategy and consulting catalogue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Twelve service lines: brand and go-to-market strategy, positioning and messaging, market and competitor research, pricing and packaging, sales playbooks, content strategy, marketing stack audits, IT and AI roadmaps, digital transformation assessment, operating model and org design, workshop facilitation and executive advisory."
          }
        },
        {
          "@type": "Question",
          "name": "Which pod includes strategy work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Only the Strategy Pod, also called the Growth Pod, at $9,000/month for 360 credits. It is the tier that contains all three catalogues: strategy, creative and digital marketing."
          }
        },
        {
          "@type": "Question",
          "name": "Is this consulting or an agency retainer?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is a subscription pod that contains consulting and production. The same team that writes the positioning builds the campaign that expresses it, which is what makes the strategy accountable rather than advisory."
          }
        },
        {
          "@type": "Question",
          "name": "Do you do IT and AI roadmaps as well as marketing strategy?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The catalogue includes IT and AI roadmaps, digital transformation assessment and operating model design, alongside conventional brand and go-to-market work."
          }
        }
      ]
    }
