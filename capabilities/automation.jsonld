    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/capabilities/automation.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is in the AI and automation catalogue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eight service lines: automation discovery and process audit, simple to complex workflow builds, retrieval chatbots on your own content, AI voice agents, custom role-specific agents, AI content pipelines, integration with existing tools, and agent monitoring and evaluation."
          }
        },
        {
          "@type": "Question",
          "name": "How do you decide what to automate first?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The audit ranks processes by volume multiplied by monotony — the work that consumes the most hours for the least judgement. That ranking becomes the build queue."
          }
        },
        {
          "@type": "Question",
          "name": "Can an agent act without human approval?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Not on anything consequential. The deployment model keeps a human approval step and monitors agent activity, so autonomy is bounded by review rather than by optimism."
          }
        },
        {
          "@type": "Question",
          "name": "Do we need to change the software we already use?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "No. The catalogue is built around integrating with what is already in place; the single-licence replacements are a separate, optional direction."
          }
        }
      ]
    }
  ]
