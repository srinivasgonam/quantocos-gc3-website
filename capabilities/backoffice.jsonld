    {
      "@type": "FAQPage",
      "@id": "https://quantocos.com/capabilities/backoffice.html#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "What is in the back office catalogue?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Eight service lines: business operations and process support, finance and accounting support, HR operations and onboarding, compliance and documentation, vendor and procurement administration, research and market intelligence, data operations, and document processing and review."
          }
        },
        {
          "@type": "Question",
          "name": "Is this the same as outsourcing a department?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "It is closer to a shared function than to body-shopping. The work sits inside a pod with a named manager and a visible credit pool, and the credit rate is set out in your engagement letter, with no per-seat markup."
          }
        },
        {
          "@type": "Question",
          "name": "Can back-office work be combined with creative or marketing work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes, and that is usually the point: a client's finance and HR requests run through the same portal and the same credit pool as their campaign work, with one monthly number."
          }
        },
        {
          "@type": "Question",
          "name": "How is compliance work handled?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Compliance and documentation support is delivered to documentation standards held by the Operational Excellence Council, and D3 — the document verification product — provides a unique ID and a public verification space for documents issued."
          }
        }
      ]
    }
  ]
